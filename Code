
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="description" content="PixelWeb creates modern, responsive websites for businesses and individuals.">
<title>PixelWeb | Modern Website Design</title>

<style>
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  scroll-behavior: smooth;
}

:root {
  --bg: #080d19;
  --card: #111a2c;
  --blue: #65a5ff;
  --white: #f5f7ff;
  --muted: #a6b1c5;
  --border: rgba(255,255,255,.10);
}

body {
  font-family: Arial, sans-serif;
  background: var(--bg);
  color: var(--white);
  line-height: 1.6;
}

a {
  text-decoration: none;
  color: inherit;
}

.container {
  width: 90%;
  max-width: 1100px;
  margin: auto;
}

header {
  position: sticky;
  top: 0;
  z-index: 10;
  background: rgba(8,13,25,.95);
  border-bottom: 1px solid var(--border);
}

nav {
  height: 72px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.logo {
  font-size: 25px;
  font-weight: 800;
  letter-spacing: -1px;
}

.logo span {
  color: var(--blue);
}

.nav-links {
  display: flex;
  gap: 25px;
  list-style: none;
}

.nav-links a {
  color: var(--muted);
  font-size: 14px;
}

.nav-links a:hover {
  color: var(--blue);
}

.menu {
  display: none;
  background: var(--card);
  color: white;
  border: 1px solid var(--border);
  padding: 8px 12px;
  border-radius: 8px;
  cursor: pointer;
  font-size: 18px;
}

.hero {
  padding: 110px 0;
  min-height: 580px;
  display: flex;
  align-items: center;
  background:
    radial-gradient(circle at 80% 30%,
    rgba(45,115,230,.22), transparent 45%);
}

.tag {
  display: inline-block;
  color: var(--blue);
  background: rgba(101,165,255,.10);
  border: 1px solid rgba(101,165,255,.3);
  padding: 7px 15px;
  border-radius: 30px;
  font-size: 12px;
  margin-bottom: 22px;
}

h1 {
  font-size: clamp(43px, 8vw, 75px);
  line-height: 1.08;
  letter-spacing: -2px;
  max-width: 750px;
}

h1 span {
  color: var(--blue);
}

.hero p {
  max-width: 580px;
  color: var(--muted);
  font-size: 17px;
  margin: 24px 0 30px;
}

.btn {
  display: inline-block;
  padding: 13px 22px;
  border-radius: 9px;
  font-weight: bold;
  margin: 5px 8px 5px 0;
  transition: .2s;
  cursor: pointer;
}

.btn:hover {
  transform: translateY(-3px);
}

.primary {
  background: var(--blue);
  color: #08101e;
}

.secondary {
  border: 1px solid var(--border);
  color: var(--white);
}

section {
  padding: 85px 0;
}

.section-title {
  font-size: 34px;
  margin-bottom: 10px;
}

.subtitle {
  color: var(--muted);
  margin-bottom: 35px;
}

.grid {
  display: grid;
  grid-template-columns: repeat(3,1fr);
  gap: 20px;
}

.card {
  background: var(--card);
  padding: 27px;
  border: 1px solid var(--border);
  border-radius: 15px;
  transition: .2s;
}

.card:hover {
  transform: translateY(-5px);
  border-color: var(--blue);
}

.symbol {
  font-size: 30px;
  margin-bottom: 15px;
}

.card h3 {
  margin-bottom: 12px;
}

.card p {
  color: var(--muted);
  font-size: 14px;
}

.about {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: 16px;
  padding: 30px;
  color: var(--muted);
}

.price {
  color: var(--blue);
  font-size: 28px;
  font-weight: bold;
  margin: 18px 0;
}

.card ul {
  list-style: none;
  color: var(--muted);
  font-size: 14px;
}

.card li {
  margin: 9px 0;
}

.project-label {
  color: var(--blue);
  font-size: 12px;
  margin-bottom: 12px;
  letter-spacing: 1px;
}

.contact {
  text-align: center;
  padding: 55px 25px;
  background: linear-gradient(135deg,#14294b,#111a2c);
  border: 1px solid var(--border);
  border-radius: 18px;
}

.contact p {
  color: var(--muted);
  max-width: 520px;
  margin: 15px auto 25px;
}

.contact-buttons {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 10px;
}

footer {
  padding: 25px 0;
  text-align: center;
  color: var(--muted);
  font-size: 13px;
  border-top: 1px solid var(--border);
}

@media(max-width:700px) {
  .menu {
    display: block;
  }

  .nav-links {
    display: none;
    position: absolute;
    top: 72px;
    left: 0;
    width: 100%;
    background: #111a2c;
    padding: 22px;
    flex-direction: column;
  }

  .nav-links.show {
    display: flex;
  }

  .grid {
    grid-template-columns: 1fr;
  }

  .hero {
    padding: 85px 0;
  }

  section {
    padding: 65px 0;
  }
}
</style>
</head>

<body>

<header>
  <nav class="container">

    <a href="#home" class="logo">
      Pixel<span>Web.</span>
    </a>

    <button class="menu" id="menuBtn"
      aria-label="Toggle navigation"
      aria-expanded="false">
      ☰
    </button>

    <ul class="nav-links" id="navLinks">
      <li><a href="#home">Home</a></li>
      <li><a href="#about">About</a></li>
      <li><a href="#services">Services</a></li>
      <li><a href="#work">Our Work</a></li>
      <li><a href="#pricing">Pricing</a></li>
      <li><a href="#contact">Contact</a></li>
    </ul>

  </nav>
</header>

<main>

<!-- HOME -->

<section class="hero" id="home">
  <div class="container">

    <span class="tag">

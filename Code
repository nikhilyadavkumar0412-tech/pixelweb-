    </div>

  </div>
</section>

<!-- SERVICES -->

<section id="services">
  <div class="container">

    <h2 class="section-title">Our Services</h2>

    <p class="subtitle">
      Solutions for your digital presence
    </p>

    <div class="grid">

      <div class="card">
        <div class="symbol">✦</div>
        <h3>Business Websites</h3>
        <p>
          Professional websites for shops,
          businesses and local brands.
        </p>
      </div>

      <div class="card">
        <div class="symbol">▣</div>
        <h3>Personal Portfolios</h3>
        <p>
          Personal websites to showcase your
          work, skills and achievements.
        </p>
      </div>

      <div class="card">
        <div class="symbol">◈</div>
        <h3>Landing Pages</h3>
        <p>
          Beautiful landing pages to introduce
          services and products.
        </p>
      </div>

    </div>
  </div>
</section>

<!-- PROJECTS -->

<section id="work">
  <div class="container">

    <h2 class="section-title">Our Work</h2>

    <p class="subtitle">
      Website concepts created by PixelWeb
    </p>

    <div class="grid">

      <div class="card">
        <div class="project-label">DEMO CONCEPT 01</div>
        <h3>Restaurant Website</h3>
        <p>
          A modern concept for a restaurant
